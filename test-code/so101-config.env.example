# Set this to "leader" on the cockpit/control station, or "follower" on Aloha Mini.
SO101_ROLE=leader

# Set to the Aloha Mini hostname/IP on the leader station. Leave empty on Aloha Mini.
SO101_FOLLOWER_HOST=aloha-mini.local

# Serial ports attached to the leader/control station.
SO101_LEFT_LEADER_PORT=/dev/ttyACM1
SO101_RIGHT_LEADER_PORT=/dev/ttyACM0

# Serial ports attached to Aloha Mini.
SO101_LEFT_FOLLOWER_PORT=/dev/ttyACM0
SO101_RIGHT_FOLLOWER_PORT=/dev/ttyACM1

# Keep matching values on both devices.
SO101_LEFT_ZMQ_PORT=5555
SO101_RIGHT_ZMQ_PORT=5556
SO101_FREQUENCY=30

# Aloha Mini camera service settings.
SO101_CAMERA_PORT=8000
SO101_CAMERA_INDEX=0

# LeRobot checkout inside the ARGUS repository clone.
LEROBOT_ROOT=~/ARGUS-collaboration/lerobot
# Or uncomment and set the exact interpreter:
# LEROBOT_PYTHON=~/ARGUS-collaboration/lerobot/.venv/bin/python
